# Пример окружения API Gateway.
# Реальный файл: /etc/compute-control/api-gateway.env (chmod 600, создаётся скриптом).
LISTEN_ADDR=127.0.0.1:8090
DATABASE_URL=postgres://control:CHANGE_ME@127.0.0.1:5432/compute_control?sslmode=disable
NATS_URL=nats://127.0.0.1:4222
# Pepper для HMAC-SHA256 над секретами API-ключей. Минимум 32 символа.
# Генерируется один раз и хранится только здесь; смена обнулит все выпущенные ключи.
API_PEPPER=CHANGE_ME_32+_RANDOM_CHARACTERS
# Участник качает программу и регистрируется сам, без кода приглашения.
ALLOW_OPEN_ENROLL=1
